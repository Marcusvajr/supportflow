PROJECT_NAME=SupportFlow
GLOBAL_PREFIX=api/v1

# Context7
CONTEXT7_API_KEY=

# Stitch
STITCH_API_KEY=

# Vercel
VERCEL_API_TOKEN=

# Supabase
SUPABASE_ACCESS_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=
DIRECT_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
# JWT key é opcional: vazio usa JWKS obtido com CLERK_SECRET_KEY.
# Issuer é derivado da publishable key; configure explicitamente somente se necessário.
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000
# IDs Clerk de usuários fictícios previamente criados; sem associação o acesso é negado.
DEMO_AGENT_CLERK_ID=
DEMO_SUPERVISOR_CLERK_ID=
DEMO_INACTIVE_CLERK_ID=
# Playwright: contas fictícias existentes na instância de desenvolvimento, com e-mail/senha.
E2E_CLERK_AGENT_EMAIL=
E2E_CLERK_AGENT_PASSWORD=
E2E_CLERK_INACTIVE_EMAIL=
E2E_CLERK_INACTIVE_PASSWORD=

# Open Source AI / OmniRoute
OMNIROUTE_API_KEY=

# Aplicação
FRONTEND_PORT=3000
BACKEND_PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Observabilidade
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# SonarQube local (seção 6 do Delivery)
SONARQUBE_TOKEN=
SONARQUBE_HOST=http://localhost:9000
# O MCP roda em container e acessa o SonarQube do host por este endereço no Docker Desktop.
SONARQUBE_MCP_URL=http://host.docker.internal:9000
SONARQUBE_PROJECT_KEY=supportflow
